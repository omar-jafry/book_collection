<p style="color: green"><%= notice %></p>

<p>
  <strong>Username:</strong>
  <%= @user_book.user.username %>
</p>

<p>
  <strong>Book Title:</strong>
  <%= @user_book.book.title %>
</p>

<div>
  <%= link_to "Edit this User Book", edit_user_book_path(@user_book) %>
  <%= link_to "Back to User Books", user_books_path %>
  <%= link_to "Destroy this User Book", @user_book,
        data: {
          turbo_method: :delete,
          turbo_confirm: "Are you sure?"
        } %>
</div>