<% if notice %>
    <p style="color: orange"><%= notice %></p>
<% end %>

<% content_for :title, "Books" %>

<h1>Books</h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>

    <p>
      <%= link_to "Show this book", book %> |
      <%= link_to "Edit this book", edit_book_path(book) %> |
      <%= link_to "Delete this book", "/books/#{book.id}/delete" %>
    </p>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>
<%= link_to "User Books", user_books_path %>
<%= link_to "Users", users_path %>